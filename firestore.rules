rules_version = '2';

// Every school is a tenant under /schools/{sid}. A signed-in user can touch a
// school's data only when they have a document in that school's /members.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(sid) {
      return /databases/$(db)/documents/schools/$(sid)/members/$(request.auth.uid);
    }

    function isMember(sid) {
      return signedIn() && exists(memberDoc(sid));
    }

    function isAdmin(sid) {
      return isMember(sid) && get(memberDoc(sid)).data.role == 'beheerder';
    }

    function schoolAfterWrite(sid) {
      return getAfter(/databases/$(db)/documents/schools/$(sid)).data;
    }

    // One profile per user: which schools they belong to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Join codes let a colleague attach themselves to an existing school.
    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && schoolAfterWrite(request.resource.data.schoolId).createdBy == request.auth.uid;
      allow update, delete: if signedIn() && isAdmin(resource.data.schoolId);
    }

    match /schools/{sid} {
      allow read: if isMember(sid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin(sid)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(sid);
        // Bootstrap: the creator adds themself as beheerder in the same batch
        // that creates the school.
        allow create: if signedIn() && request.auth.uid == uid && (
          (request.resource.data.role == 'beheerder'
            && schoolAfterWrite(sid).createdBy == request.auth.uid)
          ||
          // A colleague joins with the school's join code.
          (request.resource.data.role == 'medewerker'
            && request.resource.data.joinCode == get(/databases/$(db)/documents/schools/$(sid)).data.joinCode)
        );
        allow update, delete: if isAdmin(sid) && uid != request.auth.uid;
      }

      match /students/{id} {
        allow read, write: if isMember(sid);
      }
      match /titles/{isbn} {
        allow read, write: if isMember(sid);
      }
      match /copies/{id} {
        allow read, write: if isMember(sid);
      }
      match /loans/{id} {
        allow read, write: if isMember(sid);
      }
    }
  }
}
