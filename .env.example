# Copy this file to .env and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration -> Config
#
# .env is gitignored. These same variables are also set in the Netlify UI,
# where `inject-env.js` reads them at build time.
#
# Note: these are *not* secrets. The Firebase web config ships to every visitor
# in the browser bundle by design. They live in env vars to keep the repository
# clean and to make swapping projects easy — not to hide them.
#
# Then run:  npm run env:local

NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_APP_ID=
